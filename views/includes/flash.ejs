<% if(success && success.length) { %>
    <div class="alert alert-success alert-dismissible fade show col-6 offset-3" role="alert" id="successAlert">
        <%= success %>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="btn-close"></button>
    </div>
    <script>
        setTimeout(function() {
            var alert = document.getElementById('successAlert');
            var bsAlert = new bootstrap.Alert(alert);
            bsAlert.close();
        }, 3000); // 3000 milliseconds = 3 seconds
    </script>
<% } %>
<% if(error && error.length) { %>
    <div class="alert alert-danger alert-dismissible fade show col-6 offset-3" role="alert" id="errorAlert">
        <%= error %>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="btn-close"></button>
    </div>
    <script>
        setTimeout(function() {
            var alert = document.getElementById('errorAlert');
            var bsAlert = new bootstrap.Alert(alert);
            bsAlert.close();
        }, 3000); // 3000 milliseconds = 3 seconds
    </script>
<% } %>  